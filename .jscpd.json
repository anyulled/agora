{
  "threshold": 10,
  "minLines": 5,
  "minTokens": 50,
  "mode": "mild",
  "format": ["typescript", "javascript"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.git/**",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.d.ts",
    "**/*.d.mts"
  ],
  "reporters": ["ai"]
}
