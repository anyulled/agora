{
  "name": "agora",
  "version": "0.1.0",
  "private": true,
  "description": "Agora — Interactive Conference Presentation Platform",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:dup": "node harness/verify-duplication.mjs",
    "lint:mermaid": "node harness/verify-mermaid.mjs",
    "lint:openapi": "node harness/verify-openapi.mjs",
    "lint": "biome lint . && eslint . --max-warnings=0 && node harness/verify-duplication.mjs && node harness/verify-mermaid.mjs && node harness/verify-openapi.mjs && node harness/verify-architecture.mjs && node harness/validate-harness.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && eslint . --max-warnings=0 && node harness/verify-duplication.mjs && node harness/verify-mermaid.mjs && node harness/verify-openapi.mjs && node harness/verify-architecture.mjs && node harness/validate-harness.mjs",
    "test": "vitest run",
    "test:unit": "vitest run packages/ apps/",
    "test:integration": "vitest run tests/integration/",
    "test:perf": "vitest run tests/performance/",
    "test:e2e": "vitest run tests/e2e/",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test && node harness/victory-detector.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "commitlint": "node harness/verify-commit-msg.mjs --last",
    "cf:emulate": "node infrastructure/cloudflare/local-emulate-check.mjs",
    "cf:provision": "node infrastructure/cloudflare/provision.mjs",
    "harness:validate": "node harness/validate-harness.mjs",
    "harness:arch": "node harness/verify-architecture.mjs",
    "harness:victory": "node harness/victory-detector.mjs",
    "harness:graph": "node harness/maker-checker-graph.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/js": "^9.39.5",
    "@rtuin/mcp-mermaid-validator": "^0.7.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jscpd": "^5.4.1",
    "jsdom": "^30.1.3",
    "mermaid": "^12.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
